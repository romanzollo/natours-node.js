# Local: copy to .env. Render/Fly: set the same keys in the dashboard (not from .env file).
NODE_ENV=development
PORT=8000

# MongoDB Atlas connection string; use <PASSWORD> placeholder
DATABASE=mongodb+srv://<user>:<PASSWORD>@cluster.mongodb.net/natours?retryWrites=true&w=majority
DATABASE_PASSWORD=your_db_password

JWT_SECRET=your_jwt_secret_min_32_chars
JWT_EXPIRES_IN=90d
JWT_COOKIE_EXPIRES_IN=90

EMAIL_FROM=noreply@example.com
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=

YANDEX_MAPS_KEY=

YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_WEBHOOK_SECRET=
